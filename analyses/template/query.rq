# Mass fractions (wt %) per analysis and element. ?record = the analysed records (analyses).
# Pattern: knowledge-graph queries/find-analysis-by-object.rq.
PREFIX afr:  <http://purl.allotrope.org/ontologies/result#>
PREFIX afx:  <http://purl.allotrope.org/ontologies/property#>
PREFIX qudt: <http://qudt.org/schema/qudt#>

SELECT ?record ?element ?value WHERE {
  ?record afx:AFX_0000395 ?m .        # has output
  ?m a afr:AFR_0002099 ;              # mass fraction
     afx:AFX_0002816 ?element ;       # quantifies
     qudt:numericValue ?value .       # upper limits and "not detected" have no value: left out
}
