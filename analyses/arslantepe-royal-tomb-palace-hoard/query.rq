# Mass fractions (wt %) of every analysed object from the Royal Tomb and the Palace Hoard of
# Arslantepe. ?record = the analyses (they carry the values). A sample can come from the object
# or one of its parts (knowledge-graph queries/find-analysis-by-object.rq). Measurements
# without a value are returned too: ?max = upper limit ("< x"), ?status = :not_detected.
PREFIX crm:        <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmsci:     <http://www.cidoc-crm.org/extensions/crmsci/>
PREFIX crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/>
PREFIX afr:        <http://purl.allotrope.org/ontologies/result#>
PREFIX afx:        <http://purl.allotrope.org/ontologies/property#>
PREFIX qudt:       <http://qudt.org/schema/qudt#>
PREFIX rdfs:       <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?record ?context ?find ?element ?value ?max ?status WHERE {
  VALUES ?feature {
    <https://lod-am.net/id/feature/230027af-11bd-4fce-ac4d-39cd542cf78d>   # Royal Tomb
    <https://lod-am.net/id/feature/252b75ad-286f-4a5d-9b39-b340730e0869>   # Palace Hoard
  }
  ?feature rdfs:label ?context . FILTER(LANG(?context) = "en")
  ?find crmarchaeo:AP21i_is_contained_in ?feature ;
        crm:P46_is_composed_of* ?part .          # the object itself or one of its parts
  ?sampling crmsci:O3_sampled_from ?part ;
            crmsci:O5_removed ?sample .
  ?record afx:AFX_0000399 ?sample ;              # has input
          afx:AFX_0000395 ?m .                   # has output
  ?m a afr:AFR_0002099 ;                         # mass fraction
     afx:AFX_0002816 ?element .                  # quantifies
  OPTIONAL { ?m qudt:numericValue ?value }
  OPTIONAL { ?m afx:AFX_0000331/qudt:numericValue ?max }   # maximum (upper limit)
  OPTIONAL { ?m crm:P2_has_type ?status }                 # :not_detected
}
