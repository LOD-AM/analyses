    given-names: Fabian
    orcid: "https://orcid.org/0000-0003-3223-2079"
    website: "https://lod-am.net/about/"
repository-code: "https://github.com/LOD-AM/analyses"
url: "https://lod-am.net/"
license:
  - MIT
  - CC-BY-4.0
keywords:
  - Linked Open Data
  - archaeometallurgy
  - statistics
  - R
  - provenance
